generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum member_role {
  viewer
  member
  lead
  admin
}

enum item_type {
  incident
  customer_issue
  payment
  compliance
  task
}

enum item_priority {
  low
  medium
  high
  urgent
}

enum item_status {
  open
  in_progress
  awaiting_approval
  resolved
  closed
}

enum job_status {
  pending
  processing
  done
  failed
}

model users {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String   @unique @db.Citext
  name          String
  password_hash String
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  memberships         memberships[]
  work_items_assigned work_items[]      @relation("assignee")
  work_items_created  work_items[]      @relation("creator")
  comments            comments[]
  activity_events     activity_events[]
  idempotency_keys    idempotency_keys[]
  notifications       notifications[]
}

model teams {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String   @unique
  created_at DateTime @default(now()) @db.Timestamptz(6)

  memberships memberships[]
  work_items  work_items[]
}

model memberships {
  user_id String      @db.Uuid
  team_id String      @db.Uuid
  role    member_role

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  team teams @relation(fields: [team_id], references: [id], onDelete: Cascade)

  @@id([user_id, team_id])
  @@index([team_id], map: "memberships_team_idx")
}

model work_items {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  team_id     String        @db.Uuid
  title       String
  description String        @default("")
  type        item_type
  priority    item_priority @default(medium)
  status      item_status   @default(open)
  assignee_id String?       @db.Uuid
  created_by  String        @db.Uuid
  due_date    DateTime?     @db.Timestamptz(6)
  version     Int           @default(1)
  search      Unsupported("tsvector")?
  created_at  DateTime      @default(now()) @db.Timestamptz(6)
  updated_at  DateTime      @default(now()) @db.Timestamptz(6)

  team     teams  @relation(fields: [team_id], references: [id])
  assignee users? @relation("assignee", fields: [assignee_id], references: [id])
  creator  users  @relation("creator", fields: [created_by], references: [id])

  comments        comments[]
  activity_events activity_events[]
  notifications   notifications[]

  @@index([team_id, created_at(sort: Desc), id(sort: Desc)], map: "items_team_created_idx")
  @@index([team_id, status, priority], map: "items_team_status_prio_idx")
}

model comments {
  id         BigInt   @id @default(autoincrement())
  item_id    String   @db.Uuid
  author_id  String   @db.Uuid
  body       String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  item   work_items @relation(fields: [item_id], references: [id])
  author users      @relation(fields: [author_id], references: [id])

  @@index([item_id, created_at], map: "comments_item_idx")
}

model activity_events {
  id         BigInt   @id @default(autoincrement())
  item_id    String   @db.Uuid
  actor_id   String?  @db.Uuid
  event_type String
  from_value String?
  to_value   String?
  payload    Json     @default("{}")
  created_at DateTime @default(now()) @db.Timestamptz(6)

  item  work_items @relation(fields: [item_id], references: [id])
  actor users?     @relation(fields: [actor_id], references: [id])

  @@index([item_id, id], map: "activity_item_idx")
}

model idempotency_keys {
  user_id         String   @db.Uuid
  key             String
  request_hash    String
  response_status Int?
  response_body   Json?
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  user users @relation(fields: [user_id], references: [id])

  @@id([user_id, key])
}

model outbox_jobs {
  id           BigInt     @id @default(autoincrement())
  type         String
  payload      Json
  status       job_status @default(pending)
  attempts     Int        @default(0)
  max_attempts Int        @default(5)
  run_at       DateTime   @default(now()) @db.Timestamptz(6)
  locked_at    DateTime?  @db.Timestamptz(6)
  last_error   String?
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  processed_at DateTime?  @db.Timestamptz(6)
}

model notifications {
  id         BigInt    @id @default(autoincrement())
  user_id    String    @db.Uuid
  item_id    String    @db.Uuid
  message    String
  dedupe_key String    @unique
  read_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  user users      @relation(fields: [user_id], references: [id])
  item work_items  @relation(fields: [item_id], references: [id])
}
