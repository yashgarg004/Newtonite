# ---------------------------------------------------------------
# Operations Under Pressure: root .gitignore (covers api/ and web/)
# ---------------------------------------------------------------

# Dependencies
node_modules/
.pnp.*
.yarn/

# Build output
dist/
build/
out/
*.tsbuildinfo

# Environment files (commit .env.example, never real secrets)
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Tests and coverage
coverage/
.nyc_output/
.vitest/
test-results/

# Vite and tooling caches
.vite/
vite.config.*.timestamp-*
.cache/
.eslintcache
.npm/
.turbo/

# Docker and local database data
pgdata/
postgres-data/
docker-compose.override.yml

# Prisma
# Do NOT ignore prisma/migrations or prisma/schema.prisma. They must be committed.
*.db
*.db-journal

# Keys and certificates
*.pem
*.key
*.crt

# Temporary files
tmp/
temp/
*.tmp
*.bak

# Editors and IDEs
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Lockfiles are NOT ignored on purpose:
# keep package-lock.json in api/ and web/ so a fresh clone installs the same versions.